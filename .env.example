PORT=8450
HOST=127.0.0.1

# Required
ATOLL_SECRETS_KEY=replace-with-long-random-secret
ATOLL_LLM_PROVIDER_API_KEY=

# Usually leave these as-is
CONTAINER_CLI=docker
RUNTIME_PROVIDER=openrouter
RUNTIME_MODEL=anthropic/claude-sonnet-4.6
RUNTIME_HTTP_TIMEOUT_MS=3600000
RUNTIME_OPENCLAW_IMAGE=zivhm/openclaw
RUNTIME_ZEROCLAW_IMAGE=zivhm/zeroclaw-runtime
RUNTIME_HERMES_IMAGE=nousresearch/hermes-agent
ATOLL_SUPPORTED_RUNTIME_TYPES=openclaw,zeroclaw,hermes
ATOLL_DEFAULT_RUNTIME_TYPE=openclaw

# Optional: only set this when the browser UI is served from a different origin than the API.
ATOLL_CORS_ALLOWED_ORIGINS=
